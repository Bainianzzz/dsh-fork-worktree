{
  "name": "@bainianzzz/dsh-fork-worktree",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: fork a workspace row into a git worktree, or delete the workspace folder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bainianzzz/dsh-fork-worktree.git"
  },
  "homepage": "https://github.com/Bainianzzz/dsh-fork-worktree#readme",
  "bugs": "https://github.com/Bainianzzz/dsh-fork-worktree/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "git",
    "worktree",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "impl.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
